---
interface PostImage {
  url: string;
  alt: string;
}

interface PostData {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  image?: PostImage;
}

export interface BlogPost {
  slug: string;
  data: PostData;
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
---

<article class="group bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col">
  <div class="h-56 overflow-hidden relative">
    {post.data.image && (
      <img src={post.data.image.url} alt={post.data.image.alt} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"/>
    )}
    <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-[#0284c7] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
      {post.data.tags[0] || 'Discovery'}
    </span>
  </div>
  <div class="p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center gap-2 mb-2 text-xs text-gray-500 font-medium">
        <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        <span>•</span>
        <span class="text-[#059669] font-semibold">Ultra HD</span>
      </div>
      <a href={`/blog/${post.slug}`}>
        <h3 class="text-xl font-heading text-[#0f172a] mb-3 group-hover:text-[#0284c7] transition-colors line-clamp-2 leading-snug">
          {post.data.title}
        </h3>
      </a>
      <p class="text-gray-600 text-sm mb-6 line-clamp-3 font-light leading-relaxed">
        {post.data.description}
      </p>
    </div>
    <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-sm font-semibold text-[#0284c7] hover:text-[#0369a1] transition-colors">
      <span>Watch Episode</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </a>
  </div>
</article>