<footer class="w-full bg-[#0a0e17]/95 border-t border-gray-800 text-gray-400 py-12 px-6 mt-16 backdrop-blur-md">
  <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
    
    <!-- Channel Title -->
    <h3 class="text-white text-xl font-extrabold tracking-widest mb-3">PLANET EXPLORER</h3>
    
    <!-- Shortened Cinematic Description -->
    <p class="text-sm md:text-base leading-relaxed text-gray-300 mb-8 max-w-2xl text-center">
      Welcome to <strong class="text-white">Planet Explorer</strong>—a cinematic sanctuary dedicated to the awe-inspiring majesty and unbridled beauty of our world. We capture the raw, unfiltered essence of Earth in ultra-high definition, transcending traditional travel vlogs to bring you immersive visual journeys across remote frontiers, ancient cultures, and breathtaking natural wonders.
    </p>

    <!-- Professional Contact Card -->
    <div class="bg-[#151a24] border border-gray-800/80 rounded-xl px-6 py-4 mb-8 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-md w-full shadow-lg">
      <div class="text-center sm:text-left">
        <h4 class="text-white text-sm font-semibold">Business & Collaborations</h4>
        <p class="text-xs text-gray-400">brightwinisreal106@gmail.com</p>
      </div>
      <a href="https://mail.google.com/mail/?view=cm&fs=1&to=brightwinisreal106@gmail.com" target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition-colors shadow-md whitespace-nowrap">
        Contact Me
      </a>
    </div>

    <!-- Navigation Links -->
    <div class="flex items-center justify-center space-x-6 text-sm font-medium mb-6">
      <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
      <a href="#featured" class="hover:text-blue-400 transition-colors">All Videos</a>
      <a href="https://www.youtube.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">Subscribe on YouTube</a>
    </div>

    <!-- Copyright -->
    <div class="text-xs text-gray-500 border-t border-gray-800/80 pt-6 w-full">
      &copy; 2026 PLANET EXPLORER. All rights reserved.
    </div>

  </div>
</footer>