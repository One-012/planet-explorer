---
// src/components/Header.astro

// Thay link kênh YouTube của bạn vào đây
const YOUTUBE_CHANNEL = "https://www.youtube.com/@PlanetExplorer-DB";
---

<!-- Intro Animation Overlay với khung cảnh núi non hùng vĩ -->
<div id="intro-overlay" class="fixed inset-0 z-[100] bg-cover bg-center flex items-center justify-center overflow-hidden transition-all duration-700" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&q=80&w=1920');">
  
  <!-- Lớp chớp sáng trắng màn hình -->
  <div id="white-flash" class="absolute inset-0 bg-white opacity-0 pointer-events-none z-20 transition-opacity duration-400"></div>

  <!-- Logo rơi từ trên trời xuống -->
  <div class="relative z-30 flex items-center justify-center">
    <img 
      src="/img/logo.jpg" 
      alt="Planet Explorer Logo" 
      id="intro-logo" 
      class="w-36 h-36 md:w-48 md:h-48 object-cover rounded-full shadow-[0_0_50px_rgba(255,255,255,0.7)] border-4 border-white animate-fall transition-all duration-800 cubic-bezier(0.16, 1, 0.3, 1)"
    />
  </div>
</div>

<header class="w-full bg-[#0f0f0f]/90 backdrop-blur-md border-b border-gray-800 sticky top-0 z-50 px-6 py-4 flex items-center justify-between">
  
  <!-- Logo chính thức trên Header: Bấm vào quay về trang chủ -->
  <a href="/" id="header-logo" class="flex items-center space-x-3 text-white font-extrabold tracking-wider text-lg shrink-0 opacity-0 transition-opacity duration-300">
    <img 
      src="/img/logo.jpg" 
      alt="Planet Explorer Logo" 
      class="w-10 h-10 object-cover rounded-full shadow-md"
    />
    <span class="hidden sm:inline">PLANET EXPLORER</span>
  </a>

  <!-- Thanh tìm kiếm ở giữa -->
  <div class="flex items-center relative max-w-md w-full mx-4">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </span>
    <input 
      type="text" 
      id="searchInput"
      placeholder="Search adventures, countries, cultures..." 
      class="w-full bg-[#1f1f1f] border border-gray-700 text-sm rounded-full pl-10 pr-4 py-2 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 transition-colors shadow-inner"
    />
  </div>

  <!-- Nút Subscribe: Bấm vào chuyển tới YouTube -->
  <div class="flex items-center shrink-0">
    <a 
      href={YOUTUBE_CHANNEL} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="bg-red-600 hover:bg-red-700 text-white text-sm font-bold px-4 py-2 rounded-full transition-colors shadow-md"
    >
      Subscribe
    </a>
  </div>
</header>

<style>
  /* Hiệu ứng rơi */
  @keyframes fallFromSky {
    0% { transform: translateY(-130vh) scale(0.3); opacity: 0; }
    60% { transform: translateY(15px) scale(1.05); opacity: 1; }
    80% { transform: translateY(-8px) scale(0.95); }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }

  .animate-fall {
    animation: fallFromSky 1.0s cubic-bezier(0.25, 1, 0.5, 1) 0.3s forwards;
    opacity: 0;
  }
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const introOverlay = document.getElementById('intro-overlay');
    const introLogo = document.getElementById('intro-logo') as HTMLElement;
    const headerLogo = document.getElementById('header-logo');
    const whiteFlash = document.getElementById('white-flash');

    if (!introOverlay || !introLogo || !headerLogo || !whiteFlash) return;

    setTimeout(() => { whiteFlash.style.opacity = '1'; }, 2200);

    setTimeout(() => {
      const headerRect = headerLogo.getBoundingClientRect();
      const introRect = introLogo.getBoundingClientRect();

      const targetX = headerRect.left - introRect.left + (headerRect.width - introRect.width) / 2;
      const targetY = headerRect.top - introRect.top + (headerRect.height - introRect.height) / 2;
      
      const scaleX = headerRect.width / introRect.width;
      const scaleY = headerRect.height / introRect.height;
      const scale = Math.min(scaleX, scaleY);

      introLogo.style.animation = 'none';
      introLogo.style.transform = `translate(${targetX}px, ${targetY}px) scale(${scale})`;
      introLogo.style.boxShadow = 'none';
      introLogo.style.borderWidth = '2px';

      whiteFlash.style.opacity = '0';
      introOverlay.style.backgroundColor = 'transparent';
      introOverlay.style.backgroundImage = 'none';
      introOverlay.style.pointerEvents = 'none';

      setTimeout(() => {
        introOverlay.style.display = 'none';
        headerLogo.style.opacity = '1';
      }, 800);
    }, 2600);
  });
</script>