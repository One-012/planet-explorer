---
// src/pages/index.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoStats from '../components/VideoStats.astro';

// Dữ liệu video nổi bật
const featuredClips = {
  mostViewed: {
    title: "REAL LIFE IN INDONESIA! - STUNNING Women, BAJAU Sea Nomads & 17,000 ISLANDS on the Ring on Fire!",
    id: "TYztiiVcMS8",
    thumbnail: "https://img.youtube.com/vi/TYztiiVcMS8/hqdefault.jpg", 
    link: "https://www.youtube.com/watch?v=TYztiiVcMS8",
    badge: "🔥 Most Viewed"
  },
  recommended: {
    title: "REAL LIFE IN TAJIKISTAN! - STUNNING Women & the SHOCKING Reality of the POOREST Ex-Soviet Nation!",
    id: "ZdtRGRd3I5U",
    thumbnail: "https://img.youtube.com/vi/ZdtRGRd3I5U/hqdefault.jpg",
    link: "https://www.youtube.com/watch?v=ZdtRGRd3I5U",
    badge: "⭐ Editor's Recommended"
  }
};

// DỮ LIỆU PHẦN "MORE ADVENTURES"
const otherVideos = [
  {
    title: "REAL LIFE IN CURAÇAO! - The “USELESS” Dutch Island of BEAUTIFUL Women That Fooled the World!",
    id: "aVffjPQt71Q",
    thumbnail: "https://img.youtube.com/vi/aVffjPQt71Q/hqdefault.jpg",
    link: "https://www.youtube.com/watch?v=aVffjPQt71Q"
  },
  {
    title: "REAL LIFE IN COLOMBIA! - The World’s MOST BEAUTIFUL Women & SECRET Nights Men Never Forget!",
    id: "Cj8qoCAoK2E",
    thumbnail: "https://img.youtube.com/vi/Cj8qoCAoK2E/hqdefault.jpg",
    link: "https://www.youtube.com/watch?v=Cj8qoCAoK2E"
  },
  {
    title: "REAL LIFE IN VIETNAM! - STUNNING Women, $1 Street Food & Luxury Living for Less!",
    id: "Tvr7YjkgMuc",
    thumbnail: "https://img.youtube.com/vi/Tvr7YjkgMuc/hqdefault.jpg",
    link: "https://www.youtube.com/watch?v=Tvr7YjkgMuc"
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Planet Explorer - Official Blog & Channel</title>
    <!-- Đã xóa script Tailwind CDN bị lỗi CORS ở đây -->
    <style>
      @keyframes landscapeZoom { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }
      .animate-zoom { animation: landscapeZoom 15s ease-in-out infinite; }
      @keyframes waveDrift { 0% { transform: scale(1) translateY(0); } 50% { transform: scale(1.06) translateY(-8px); } 100% { transform: scale(1) translateY(0); } }
      .animate-ocean { animation: waveDrift 20s ease-in-out infinite; }
    </style>
  </head>
  <body class="text-white font-sans min-h-screen flex flex-col relative selection:bg-blue-500 selection:text-white">
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
      <div class="absolute inset-0 bg-cover bg-center animate-ocean opacity-50" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80');"></div>
      <div class="absolute inset-0 bg-[#0f0f0f]/85"></div>
    </div>

    <Header />

    <section class="relative w-full h-80 md:h-96 overflow-hidden flex items-center justify-center">
      <div class="absolute inset-0 bg-cover bg-center animate-zoom" style="background-image: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1920&q=80');"></div>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 text-center px-4 max-w-3xl text-white">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-wider mb-2 drop-shadow-lg">PLANET EXPLORER</h1>
        <p class="text-lg md:text-xl text-blue-400 italic font-medium drop-shadow-md">"LET'S EXPLORE TOGETHER"</p>
      </div>
    </section>

    <main class="flex-grow">
      <section class="max-w-5xl mx-auto px-6 pt-12 pb-6">
        <div class="bg-[#1f1f1f]/90 backdrop-blur-md border border-gray-800 p-8 rounded-2xl shadow-xl">
          <h2 class="text-2xl font-bold mb-4 text-blue-400">Welcome to Planet Explorer</h2>
          <p class="text-gray-300 leading-relaxed text-base md:text-lg">
            Welcome to <strong class="text-white">Planet Explorer</strong>, your ultimate digital gateway to the world's most breathtaking landscapes, hidden cultural gems, and extraordinary travel adventures.
          </p>
        </div>
      </section>

      <!-- Featured Highlights -->
      <section class="max-w-5xl mx-auto px-6 py-8">
        <h2 class="text-2xl font-bold mb-6 border-l-4 border-blue-500 pl-3">Featured Highlights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <a href={featuredClips.mostViewed.link} target="_blank" rel="noopener noreferrer" class="bg-[#1f1f1f]/90 backdrop-blur-md rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500 transition-all group shadow-xl flex flex-col">
            <div class="relative aspect-video overflow-hidden">
              <img src={featuredClips.mostViewed.thumbnail} alt="Most Viewed" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-3 left-3 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">{featuredClips.mostViewed.badge}</span>
            </div>
            <div class="p-5 flex flex-col flex-grow justify-between">
              <h3 class="font-bold text-lg group-hover:text-blue-400 transition-colors line-clamp-2">{featuredClips.mostViewed.title}</h3>
              <div class="flex items-center justify-between mt-4 text-sm text-gray-400">
                <VideoStats videoId={featuredClips.mostViewed.id} className="text-red-400 font-bold bg-red-950/40 px-2.5 py-1 rounded-md border border-red-900/50" />
                <span class="text-blue-400 underline font-medium">Watch on YouTube</span>
              </div>
            </div>
          </a>

          <a href={featuredClips.recommended.link} target="_blank" rel="noopener noreferrer" class="bg-[#1f1f1f]/90 backdrop-blur-md rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500 transition-all group shadow-xl flex flex-col">
            <div class="relative aspect-video overflow-hidden">
              <img src={featuredClips.recommended.thumbnail} alt="Recommended" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-3 left-3 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">{featuredClips.recommended.badge}</span>
            </div>
            <div class="p-5 flex flex-col flex-grow justify-between">
              <h3 class="font-bold text-lg group-hover:text-blue-400 transition-colors line-clamp-2">{featuredClips.recommended.title}</h3>
              <div class="flex items-center justify-between mt-4 text-sm text-gray-400">
                <VideoStats videoId={featuredClips.recommended.id} className="text-blue-400 font-bold bg-blue-950/40 px-2.5 py-1 rounded-md border border-blue-900/50" />
                <span class="text-blue-400 underline font-medium">Watch on YouTube</span>
              </div>
            </div>
          </a>
        </div>
      </section>

      <!-- More Adventures -->
      <section class="max-w-5xl mx-auto px-6 py-6 pb-16">
        <h2 class="text-xl font-bold mb-6 text-gray-200">More Adventures</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherVideos.map((video) => (
            <a href={video.link} target="_blank" rel="noopener noreferrer" class="bg-[#1f1f1f]/90 backdrop-blur-md rounded-xl overflow-hidden border border-gray-800 hover:border-gray-500 transition-all group shadow-lg flex flex-col">
              <div class="relative overflow-hidden aspect-video">
                <img src={video.thumbnail} alt={video.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
              <div class="p-4 flex flex-col flex-grow justify-between">
                <h3 class="font-semibold text-sm md:text-base line-clamp-2 group-hover:text-blue-400 transition-colors">{video.title}</h3>
                <div class="flex items-center justify-between mt-4 text-xs text-gray-400">
                  <VideoStats videoId={video.id} />
                  <span class="text-blue-400 underline">Watch</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>