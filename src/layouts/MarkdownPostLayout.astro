---
import BaseLayout from './BaseLayout.astro';

interface Frontmatter {
  title: string;
  description: string;
  pubDate: string;
  author: string;
  youtubeId?: string;
  image?: {
    url: string;
    alt: string;
  };
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props as Props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="max-w-4xl mx-auto px-6 pt-32 pb-20">
    <div class="mb-10 text-center">
      <a href="/" class="inline-block text-xs uppercase tracking-[0.2em] text-[#c5a880] mb-4 hover:underline">
        ← Back to Cinematic Library
      </a>
      <h1 class="text-3xl md:text-5xl font-heading text-white mb-6 leading-tight">{frontmatter.title}</h1>
      <div class="flex items-center justify-center gap-4 text-gray-400 text-sm font-light">
        <span>Published: {frontmatter.pubDate}</span>
        <span>•</span>
        <span>Curated by {frontmatter.author}</span>
      </div>
    </div>

    {frontmatter.image && (
      <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl border border-white/10">
        <img src={frontmatter.image.url} alt={frontmatter.image.alt} class="w-full h-[450px] md:h-[550px] object-cover" />
      </div>
    )}

    {frontmatter.youtubeId && (
      <div class="mb-12 rounded-3xl overflow-hidden shadow-2xl bg-black border border-white/10 aspect-video">
        <iframe class="w-full h-full" src={`https://www.youtube.com/embed/${frontmatter.youtubeId}`} allowfullscreen></iframe>
      </div>
    )}

    <div class="bg-[#141c19] border border-white/5 p-8 md:p-12 rounded-3xl shadow-xl prose prose-invert prose-lg max-w-none text-gray-300 font-light leading-relaxed space-y-6">
      <slot />
    </div>
  </article>
</BaseLayout>